// Local development stack only. Never used for the hosted project.
// Start with `pnpm db:start`, then `pnpm db:reset` to replay the migrations. See docs/SETUP.md.
{
  "$schema": "https://supabase.com/schemas/config/v1.json",
  "project_id": "scaffold-cms",

  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": ["public", "graphql_public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000,
  },

  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "major_version": 17,

    // The migration chain cannot replay on an empty database without a fixture account that
    // signs up right after the first migration (review finding 4.1). scripts/local-db-reset.mjs
    // applies the migrations in that order, so the CLI must not apply them itself.
    "migrations": {
      "enabled": false,
    },

    "seed": {
      "enabled": false,
    },
  },

  "realtime": { "enabled": false },
  "studio": { "enabled": true, "port": 54323 },
  "local_smtp": { "enabled": true, "port": 54324 },
  "storage": { "enabled": false },
  "edge_runtime": { "enabled": false },
  "analytics": { "enabled": false },

  "auth": {
    "enabled": true,
    "site_url": "http://localhost:4000",
    "additional_redirect_urls": ["http://127.0.0.1:4000"],
    "enable_signup": true,
    "email": {
      "enabled": true,
      "enable_confirmations": false,
    },
  },
}
